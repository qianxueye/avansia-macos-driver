+/* The status helper owns device access. Keep its execution outside the
+ * printer lock and never let a hardware refresh resolve a retained job. */
+static void
+status_apply(ippeve_printer_t *printer, const char *connection, int ribbon, int film)
+{
+  static const char * const names[] = { "marker-levels", "printer-supply", "printer-supply-description", "avansia-connection-state" };
+  static const char * const descriptions[] = { "Color ribbon", "Transfer film" };
+  ipp_attribute_t *attr;
+  int levels[2] = { ribbon, film };
+  char supply[256];
+  size_t i;
+
+  _cupsRWLockWrite(&printer->rwlock);
+  if (!strcmp(printer->connection, connection) && printer->ribbon_level == ribbon && printer->film_level == film)
+  {
+    _cupsRWUnlock(&printer->rwlock);
+    return;
+  }
+  strlcpy(printer->connection, connection, sizeof(printer->connection));
+  printer->ribbon_level = ribbon;
+  printer->film_level = film;
+  for (i = 0; i < sizeof(names) / sizeof(names[0]); i ++)
+    if ((attr = ippFindAttribute(printer->attrs, names[i], IPP_TAG_ZERO)) != NULL)
+      ippDeleteAttribute(printer->attrs, attr);
+  ippAddIntegers(printer->attrs, IPP_TAG_PRINTER, IPP_TAG_INTEGER, "marker-levels", 2, levels);
+  snprintf(supply, sizeof(supply), "index=1;class=supplyThatIsConsumed;type=inkRibbon;unit=percent;maxcapacity=100;level=%d;colorantname=multiple;", ribbon);
+  attr = ippAddOctetString(printer->attrs, IPP_TAG_PRINTER, "printer-supply", supply, (int)strlen(supply));
+  snprintf(supply, sizeof(supply), "index=2;class=supplyThatIsConsumed;type=transferUnit;unit=percent;maxcapacity=100;level=%d;colorantname=none;", film);
+  ippSetOctetString(printer->attrs, &attr, 1, supply, (int)strlen(supply));
+  ippAddStrings(printer->attrs, IPP_TAG_PRINTER, IPP_TAG_TEXT, "printer-supply-description", 2, NULL, descriptions);
+  ippAddString(printer->attrs, IPP_TAG_PRINTER, IPP_TAG_KEYWORD, "avansia-connection-state", NULL, connection);
+  printer->config_time = time(NULL);
+  if (!printer->active_job && printer->state != IPP_PSTATE_STOPPED)
+    printer->state_time = printer->config_time;
+  _cupsRWUnlock(&printer->rwlock);
+}
+
+static int
+status_parse(const char *output, char *connection, int *ribbon, int *film)
+{
+  char prefix[32], state[16], values[2][8], extra, *end;
+  int i, levels[2];
+  long value;
+
+  if (sscanf(output, "%31s %15s %7s %7s %c", prefix, state, values[0], values[1], &extra) != 4 ||
+      strcmp(prefix, "AVANSIA_STATUS_V1") ||
+      (strcmp(state, "ready") && strcmp(state, "busy") && strcmp(state, "recovery") &&
+       strcmp(state, "disconnected") && strcmp(state, "error") && strcmp(state, "unknown")))
+    return (0);
+  for (i = 0; i < 2; i ++)
+  {
+    errno = 0;
+    value = strtol(values[i], &end, 10);
+    if (errno || *end || end == values[i] || value < -1 || value > 100) return (0);
+    levels[i] = (int)value;
+  }
+  strlcpy(connection, state, 16);
+  *ribbon = levels[0];
+  *film = levels[1];
+  return (1);
+}
+
+static double
+status_now(void)
+{
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (now.tv_sec + now.tv_nsec / 1000000000.0);
+}
+
+static void
+status_tick(ippeve_printer_t *printer, ippeve_status_t *probe, double now)
+{
+  int status, fds[2], error, ribbon, film, wait_error;
+  pid_t result;
+  ssize_t bytes;
+  char connection[16];
+  posix_spawn_file_actions_t actions;
+  posix_spawnattr_t attributes;
+  char *arguments[] = { (char *)StatusCommand, "ipp-status", NULL };
+
+  if (!StatusCommand) return;
+  if (probe->pid)
+  {
+    result = waitpid(probe->pid, &status, WNOHANG);
+    wait_error = errno;
+    if (probe->fd >= 0)
+    {
+      while ((bytes = read(probe->fd, probe->output + probe->used, sizeof(probe->output) - probe->used - 1)) > 0)
+      {
+        if (memchr(probe->output + probe->used, '\0', (size_t)bytes)) probe->failed = 1;
+        probe->used += (size_t)bytes;
+        if (probe->used == sizeof(probe->output) - 1)
+        {
+          probe->failed = 1;
+          break;
+        }
+      }
+      if (bytes < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) probe->failed = 1;
+    }
+    if (result == probe->pid || (result < 0 && wait_error != EINTR))
+    {
+      kill(-probe->pid, SIGKILL);
+      if (probe->fd >= 0) close(probe->fd);
+      probe->fd = -1;
+      probe->pid = 0;
+      probe->output[probe->used] = '\0';
+      if (result > 0 && WIFEXITED(status) && !WEXITSTATUS(status) && !probe->failed &&
+          status_parse(probe->output, connection, &ribbon, &film))
+        status_apply(printer, connection, ribbon, film);
+      else
+        status_apply(printer, "unknown", -1, -1);
+      return;
+    }
+    if ((!probe->failed && now >= probe->deadline) || probe->failed == 1)
+    {
+      probe->failed = 2;
+      kill(-probe->pid, SIGKILL);
+      if (probe->fd >= 0) close(probe->fd);
+      probe->fd = -1;
+      status_apply(printer, "unknown", -1, -1);
+    }
+    return;
+  }
+  if (now < probe->next_poll) return;
+  probe->next_poll = now + 15.0;
+  probe->deadline = now + 20.0;
+  probe->failed = 0;
+  probe->used = 0;
+  if (pipe(fds)) { status_apply(printer, "unknown", -1, -1); return; }
+  if (fcntl(fds[0], F_SETFL, O_NONBLOCK))
+  {
+    close(fds[0]); close(fds[1]);
+    status_apply(printer, "unknown", -1, -1);
+    return;
+  }
+  posix_spawn_file_actions_init(&actions);
+  posix_spawn_file_actions_adddup2(&actions, fds[1], STDOUT_FILENO);
+  posix_spawn_file_actions_addclose(&actions, fds[0]);
+  posix_spawn_file_actions_addclose(&actions, fds[1]);
+  posix_spawn_file_actions_addopen(&actions, STDIN_FILENO, "/dev/null", O_RDONLY, 0);
+  posix_spawn_file_actions_addopen(&actions, STDERR_FILENO, "/dev/null", O_WRONLY, 0);
+  posix_spawnattr_init(&attributes);
+  posix_spawnattr_setflags(&attributes, POSIX_SPAWN_CLOEXEC_DEFAULT | POSIX_SPAWN_SETPGROUP);
+  posix_spawnattr_setpgroup(&attributes, 0);
+  error = posix_spawn(&probe->pid, StatusCommand, &actions, &attributes, arguments, environ);
+  posix_spawn_file_actions_destroy(&actions);
+  posix_spawnattr_destroy(&attributes);
+  close(fds[1]);
+  if (error)
+  {
+    close(fds[0]);
+    probe->pid = 0;
+    status_apply(printer, "unknown", -1, -1);
+  }
+  else probe->fd = fds[0];
+}
+
+
+static void
+status_stop(ippeve_status_t *probe)
+{
+  if (probe->pid)
+  {
+    int status;
+    kill(-probe->pid, SIGKILL);
+    while (waitpid(probe->pid, &status, 0) < 0 && errno == EINTR);
+    probe->pid = 0;
+  }
+  if (probe->fd >= 0) close(probe->fd);
+  probe->fd = -1;
+}
