 /*
+ * Persist the active identity before invoking a command. A restored job is
+ * always stopped: an interrupted physical operation must never be replayed.
+ */
+
+static int
+checkpoint_job(ippeve_job_t *job)
+{
+  ipp_t *record = ippNew();
+  char path[1024], temp[1024];
+  int fd, result = 0;
+
+  ippSetRequestId(record, 1);
+  ippAddInteger(record, IPP_TAG_OPERATION, IPP_TAG_INTEGER, "checkpoint-next-id", job->printer->next_job_id);
+  ippAddInteger(record, IPP_TAG_OPERATION, IPP_TAG_INTEGER, "checkpoint-impressions", job->impressions);
+  ippAddInteger(record, IPP_TAG_OPERATION, IPP_TAG_INTEGER, "checkpoint-completed", job->impcompleted);
+  ippAddDate(record, IPP_TAG_OPERATION, "checkpoint-processing", ippTimeToDate(job->processing));
+  ippAddString(record, IPP_TAG_OPERATION, IPP_TAG_TEXT, "checkpoint-message", NULL,
+               job->message ? job->message : "Job interrupted; explicit cancellation is required before another job.");
+  if (job->filename)
+    ippAddString(record, IPP_TAG_OPERATION, IPP_TAG_NAME, "checkpoint-filename", NULL, strrchr(job->filename, '/') + 1);
+  if (!copy_attributes(record, job->attrs, NULL, IPP_TAG_JOB))
+  {
+    ippDelete(record);
+    return (0);
+  }
+  snprintf(path, sizeof(path), "%s/active-job.ipp", job->printer->directory);
+  snprintf(temp, sizeof(temp), "%s/active-job.tmp", job->printer->directory);
+  if (ippLength(record) <= 1024 * 1024 &&
+      (fd = open(temp, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600)) >= 0)
+  {
+    result = ippWriteFile(fd, record) == IPP_STATE_DATA && !fsync(fd);
+    if (close(fd)) result = 0;
+    if (result) result = !rename(temp, path);
+    if (result && (fd = open(job->printer->directory, O_RDONLY)) >= 0)
+    {
+      result = !fsync(fd);
+      close(fd);
+    }
+    else result = 0;
+  }
+  ippDelete(record);
+  return (result);
+}
+
+static int
+clear_checkpoint(ippeve_printer_t *printer)
+{
+  char path[1024];
+  int fd, result;
+
+  snprintf(path, sizeof(path), "%s/active-job.ipp", printer->directory);
+  if (unlink(path) && errno != ENOENT) return (0);
+  if ((fd = open(printer->directory, O_RDONLY)) < 0) return (0);
+  result = !fsync(fd);
+  close(fd);
+  return (result);
+}
+
+static void
+stop_job(ippeve_job_t *job)
+{
+  job->state = IPP_JSTATE_STOPPED;
+  job->completed = 0;
+  job->printer->state = IPP_PSTATE_STOPPED;
+  job->printer->state_reasons |= IPPEVE_PREASON_OTHER;
+  job->printer->state_time = time(NULL);
+  if (!job->message)
+    job->message = strdup("Print command failed; explicit cancellation is required before another job.");
+}
+
+static int
+restore_job(ippeve_printer_t *printer)
+{
+  char path[1024];
+  int fd, next_id;
+  struct stat info;
+  ipp_t *record;
+  ipp_attribute_t *attr;
+  ippeve_job_t *job;
+
+  if (chmod(printer->directory, 0700)) return (0);
+  snprintf(path, sizeof(path), "%s/active-job.ipp", printer->directory);
+  if ((fd = open(path, O_RDONLY | O_NOFOLLOW)) < 0) return (errno == ENOENT);
+  record = ippNew();
+  if (fstat(fd, &info) || !S_ISREG(info.st_mode) || info.st_size > 1024 * 1024 ||
+      ippReadFile(fd, record) != IPP_STATE_DATA)
+  {
+    close(fd);
+    ippDelete(record);
+    return (0);
+  }
+  close(fd);
+  attr = ippFindAttribute(record, "job-id", IPP_TAG_INTEGER);
+  next_id = ippGetInteger(ippFindAttribute(record, "checkpoint-next-id", IPP_TAG_INTEGER), 0);
+  if (!attr || ippGetInteger(attr, 0) < 1 || next_id <= ippGetInteger(attr, 0))
+  {
+    ippDelete(record);
+    return (0);
+  }
+  job = calloc(1, sizeof(ippeve_job_t));
+  if (!job) { ippDelete(record); return (0); }
+  job->printer = printer;
+  job->fd = -1;
+  job->attrs = ippNew();
+  if (!copy_attributes(job->attrs, record, NULL, IPP_TAG_JOB))
+  {
+    delete_job(job);
+    ippDelete(record);
+    return (0);
+  }
+  job->id = ippGetInteger(attr, 0);
+  job->name = ippGetString(ippFindAttribute(job->attrs, "job-name", IPP_TAG_NAME), 0, NULL);
+  job->username = ippGetString(ippFindAttribute(job->attrs, "job-originating-user-name", IPP_TAG_NAME), 0, NULL);
+  job->format = "application/pdf";
+  job->created = ippDateToTime(ippGetDate(ippFindAttribute(job->attrs, "date-time-at-creation", IPP_TAG_DATE), 0));
+  job->processing = ippDateToTime(ippGetDate(ippFindAttribute(record, "checkpoint-processing", IPP_TAG_DATE), 0));
+  job->impressions = ippGetInteger(ippFindAttribute(record, "checkpoint-impressions", IPP_TAG_INTEGER), 0);
+  job->impcompleted = ippGetInteger(ippFindAttribute(record, "checkpoint-completed", IPP_TAG_INTEGER), 0);
+  attr = ippFindAttribute(record, "checkpoint-message", IPP_TAG_TEXT);
+  if (attr) job->message = strdup(ippGetString(attr, 0, NULL));
+  attr = ippFindAttribute(record, "checkpoint-filename", IPP_TAG_NAME);
+  if (attr)
+  {
+    const char *basename = ippGetString(attr, 0, NULL);
+    char prefix[32];
+    snprintf(prefix, sizeof(prefix), "%d-", job->id);
+    if (!basename || strncmp(basename, prefix, strlen(prefix)) || strchr(basename, '/') || strstr(basename, ".."))
+    {
+      delete_job(job);
+      ippDelete(record);
+      return (0);
+    }
+    snprintf(path, sizeof(path), "%s/%s", printer->directory, basename);
+    job->filename = strdup(path);
+  }
+  printer->next_job_id = next_id;
+  cupsArrayAdd(printer->jobs, job);
+  printer->active_job = job;
+  stop_job(job);
+  ippDelete(record);
+  return (1);
+}
